# Public Turnstile site key; safe to expose in rendered HTML.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Turnstile verification.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Server-only Upstash Redis REST credentials for distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use 32 random bytes encoded as 64 hexadecimal characters.
RATE_LIMIT_HASH_SECRET=

# Server-only Resend delivery configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Reserved for the later Supabase activation. Never expose the service key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
